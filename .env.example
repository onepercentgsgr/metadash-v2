# MetaDash v3.5 Environment Variables
# Copy this file as .env for local development
# In Railway/Vercel, configure these variables in the dashboard

# ── REQUIRED ──────────────────────────────────────────────

# Database (Supabase or PostgreSQL)
DATABASE_URL=postgresql://postgres:TU_PASSWORD@db.TU_PROJECT.supabase.co:5432/postgres

# JWT Secret (MUST change in production — min 32 chars)
SECRET_KEY=metadash-secret-super-seguro-cambiar-esto

# Admin credentials
ADMIN_EMAIL=admin@metadash.com
ADMIN_PASSWORD=admin2024

# Credential encryption key (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=

# ── CORS & SECURITY ──────────────────────────────────────

# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,https://metadash.vercel.app

# Environment: "development" or "production" (enables HSTS, HTTPS redirect)
ENVIRONMENT=development

# URL del frontend (for payment redirects and CORS)
FRONTEND_URL=https://metadash.vercel.app

# ── PAYMENTS ─────────────────────────────────────────────

# MercadoPago Integration
MERCADOPAGO_ACCESS_TOKEN=tu-access-token-mercadopago
MERCADOPAGO_WEBHOOK_TOKEN=tu-webhook-token-mercadopago

# Stripe Integration
STRIPE_SECRET_KEY=sk_test_tu_clave_secreta_stripe
STRIPE_PUBLISHABLE_KEY=pk_test_tu_clave_publica_stripe
STRIPE_WEBHOOK_SECRET=whsec_tu_webhook_secret_stripe
STRIPE_STARTER_PRICE_ID=price_starter
STRIPE_PRO_PRICE_ID=price_pro
STRIPE_ENTERPRISE_PRICE_ID=price_enterprise

# ── EXTERNAL APIs ────────────────────────────────────────

# Meta Ads API
META_ACCESS_TOKEN=tu-token-meta
META_AD_ACCOUNT_ID=tu-ad-account-id
META_APP_ID=tu-app-id
META_APP_SECRET=tu-app-secret

# Anthropic (required for AI agents)
ANTHROPIC_API_KEY=sk-ant-tu-clave

# HuggingFace
HF_API_KEY=tu-huggingface-api-key
