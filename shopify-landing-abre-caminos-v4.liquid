@media(max-width: 768px) { .ac-toast { bottom: 92px; max-width: calc(100% - 32px); } }

.ac-r { opacity: 0; transform: translateY(24px); transition: opacity 1.1s cubic-bezier(.2,.7,.2,1), transform 1.1s cubic-bezier(.2,.7,.2,1); }
