<script>
(function(){
  'use strict';
  var rm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  var els = document.querySelectorAll('.ac-r');
  if ('IntersectionObserver' in window && !rm) {
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
      });
    }, { rootMargin: '-40px', threshold: .08 });
    els.forEach(function(el){ io.observe(el); });
  } else {
    els.forEach(function(el){ el.classList.add('in'); });
  }

  var DUR = 15*60*1000, K = 'ac_t_v4';
  var min = document.getElementById('ac-min'), sec = document.getElementById('ac-sec');
  function end(){
    var s = +localStorage.getItem(K)||0;
    if (!s || s < Date.now()) { s = Date.now()+DUR; localStorage.setItem(K, s); }
    return s;
  }
  var E = end();
  function pad(n){ return (n<10?'0':'')+n; }
  function tick(){
    var d = Math.max(0, E - Date.now());
    var m = Math.floor(d/60000), s = Math.floor((d%60000)/1000);
    if (min) min.textContent = pad(m);
    if (sec) sec.textContent = pad(s);
    if (d === 0) { E = Date.now()+DUR; localStorage.setItem(K, E); }
  }
  tick(); setInterval(tick, 1000);

  document.querySelectorAll('[data-faq]').forEach(function(b){
    b.addEventListener('click', function(){
      var it = b.closest('.ac-faq-item');
      var open = it.classList.contains('open');
      document.querySelectorAll('.ac-faq-item').forEach(function(i){ i.classList.remove('open'); });
      if (!open) it.classList.add('open');
    });
  });

  var sticky = document.getElementById('ac-sticky');
  var hero = document.querySelector('.ac-hero');
  if (sticky && hero) {
    window.addEventListener('scroll', function(){
      var r = hero.getBoundingClientRect();
      sticky.classList.toggle('show', r.bottom < 0);
    }, { passive: true });
  }

  var data = [
    {n:'María', c:'Buenos Aires', t:'hace 2 minutos'},
    {n:'Carolina', c:'Rosario', t:'hace 4 minutos'},
    {n:'Patricia', c:'Mendoza', t:'hace 6 minutos'},
    {n:'Lucía', c:'Córdoba', t:'hace 3 minutos'},
    {n:'Silvia', c:'La Plata', t:'hace 5 minutos'},
    {n:'Natalia', c:'San Juan', t:'hace 8 minutos'}
  ];
  var toast = document.getElementById('ac-toast');
  var tn = document.getElementById('ac-toast-name');
  var tm = document.getElementById('ac-toast-meta');
  var k = 0;
  function showToast(){
    if (!toast) return;
    var d = data[k % data.length];
    tn.textContent = d.n + ' de ' + d.c;
    tm.textContent = d.t;
    toast.classList.add('show');
    setTimeout(function(){ toast.classList.remove('show'); }, 6000);
    k++;
  }
  setTimeout(showToast, 14000);
  setInterval(showToast, 90000);
})();
</script>

