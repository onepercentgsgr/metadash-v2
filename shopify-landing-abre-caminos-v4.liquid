<style>
.ac *, .ac *::before, .ac *::after { box-sizing: border-box; margin: 0; padding: 0; }
.ac {
  --ink:    #07110A;
  --bg:     #0A1408;
  --bg-2:   #0E1A0C;
  --bone:   #EFE4CC;
  --bone-2: #E8DCC0;
  --bone-d: rgba(239,228,204,.7);
  --bone-f: rgba(239,228,204,.4);
  --bone-h: rgba(239,228,204,.08);
  --gold:   #C9A961;
  --gold-2: #B89446;
  --terra:  #C97A52;

  --serif: 'Cormorant Garamond', 'EB Garamond', Georgia, serif;
  --sans:  'Inter', system-ui, -apple-system, sans-serif;

  background: var(--bg);
  color: var(--bone);
  font-family: var(--serif);
  font-weight: 400;
  font-size: 17px;
  line-height: 1.55;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  overflow-x: hidden;
}
.ac img { max-width: 100%; display: block; }
.ac a { color: inherit; text-decoration: none; }
.ac button { font: inherit; cursor: pointer; border: 0; background: none; color: inherit; }
.ac ::selection { background: var(--gold); color: var(--ink); }
.ac em { font-style: italic; color: var(--gold); font-weight: 400; }

.ac .wrap   { width: 100%; max-width: 920px; margin: 0 auto; padding: 0 28px; }
.ac .wrap-s { width: 100%; max-width: 680px; margin: 0 auto; padding: 0 28px; }
.ac section, .ac .sec { position: relative; padding: clamp(80px, 12vw, 130px) 0; }

.ac .eyebrow {
  font-family: var(--sans);
  font-size: .72rem;
  font-weight: 500;
  letter-spacing: .28em;
  text-transform: uppercase;
  color: var(--bone-d);
}
.ac .eyebrow.gold { color: var(--gold); }
.ac .display {
  font-family: var(--serif); font-weight: 400;
  line-height: .92; letter-spacing: -.02em;
  color: var(--bone);
}
.ac .display .it {
  display: block; font-style: italic; color: var(--gold);
  font-weight: 500;
}
.ac .h1 {
  font-family: var(--serif); font-weight: 400;
  font-size: clamp(2.4rem, 6.5vw, 4.6rem);
  line-height: 1; letter-spacing: -.02em;
  color: var(--bone);
}
.ac .h1 em { color: var(--gold); }
.ac .h2 {
  font-family: var(--serif); font-weight: 400;
  font-size: clamp(1.9rem, 4.4vw, 3rem);
  line-height: 1.05; letter-spacing: -.015em;
  color: var(--bone);
}
.ac .h2 em { color: var(--gold); }
.ac .h3 {
  font-family: var(--serif); font-weight: 500;
  font-size: 1.3rem; line-height: 1.25;
  color: var(--bone);
}
.ac .lede {
  font-family: var(--serif); font-style: italic; font-weight: 400;
  font-size: clamp(1.1rem, 2vw, 1.3rem);
  line-height: 1.45; color: var(--bone-d);
}
.ac p.body {
  font-family: var(--serif); font-size: 1rem;
  line-height: 1.6; color: var(--bone-d);
}

.ac-orn {
  display: flex; align-items: center; justify-content: center;
  gap: 14px;
  color: var(--gold);
  font-size: .85rem;
  margin: clamp(28px, 5vw, 44px) 0;
}
.ac-orn .dot { font-size: .55rem; opacity: .8; }

.ac .btn {
  position: relative;
  display: inline-flex; align-items: center; justify-content: center;
  gap: 10px;
  padding: 17px 30px;
  border-radius: 999px;
  background: var(--gold);
  color: var(--ink);
  font-family: var(--sans);
  font-weight: 500;
  font-size: .9rem;
  letter-spacing: .04em;
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.16),
    inset 0 -1px 0 rgba(0,0,0,.2),
    0 14px 30px -12px rgba(0,0,0,.6);
  transition: transform .35s cubic-bezier(.2,.7,.2,1),
              background .25s ease,
              box-shadow .35s cubic-bezier(.2,.7,.2,1);
  white-space: nowrap;
}
.ac .btn:hover {
  transform: translateY(-1px);
  background: var(--gold-2);
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.2),
    inset 0 -1px 0 rgba(0,0,0,.18),
    0 20px 38px -14px rgba(0,0,0,.6);
}
.ac .btn:active { transform: translateY(0); }
.ac .btn-lg { padding: 19px 36px; font-size: .95rem; }
.ac .btn .arrow {
  display: inline-block;
  transition: transform .35s cubic-bezier(.2,.7,.2,1);
}
.ac .btn:hover .arrow { transform: translateX(3px); }

.ac-hero {
  position: relative;
  min-height: 100vh; min-height: 100dvh;
  display: flex; flex-direction: column;
  background:
    radial-gradient(ellipse 50% 35% at 30% 60%, rgba(201,169,97,.07), transparent 70%),
    var(--bg);
}
.ac-hero .hero-body {
  flex: 1;
  display: flex; align-items: center;
  padding: clamp(40px, 8vw, 100px) clamp(24px, 6vw, 80px);
}
.ac-hero .hero-inner { max-width: 760px; }
.ac-hero .hero-mark {
  display: inline-flex; align-items: center; gap: 12px;
  margin-bottom: 32px;
}
.ac-hero .hero-mark-svg { width: 28px; height: 28px; }
.ac-hero .hero-mark-label {
  font-family: var(--sans); font-size: .72rem;
  letter-spacing: .26em; text-transform: uppercase;
  color: var(--bone-d);
}
.ac-hero .hero-cat {
  font-family: var(--sans); font-size: .72rem;
  letter-spacing: .26em; text-transform: uppercase;
  color: var(--bone-d);
  margin-bottom: clamp(60px, 10vw, 100px);
}
.ac-hero .display {
  font-size: clamp(3.2rem, 11vw, 7rem);
  margin-bottom: 36px;
}
.ac-hero .display .it { margin-top: -.08em; }
.ac-hero .lede { max-width: 480px; margin-bottom: 48px; }
.ac-hero .hero-cta { display: flex; align-items: center; gap: 18px; flex-wrap: wrap; }
.ac-hero .hero-cta .meta {
  font-family: var(--serif); font-style: italic;
  font-size: .9rem; color: var(--bone-f);
}
.ac-hero .hero-foot {
  display: flex; align-items: flex-end; justify-content: space-between;
  gap: 24px; flex-wrap: wrap;
  padding: 32px clamp(24px, 6vw, 80px);
  border-top: 1px solid var(--bone-h);
}
.ac-hero .hero-foot .edition {
  font-family: var(--serif); font-style: italic; font-size: .85rem;
  color: var(--bone-f);
}
.ac-hero .hero-foot .micro {
  font-family: var(--sans); font-size: .7rem;
  letter-spacing: .22em; text-transform: uppercase;
  color: var(--bone-d);
}

.ac-mod-head { margin-bottom: clamp(40px, 6vw, 64px); }
.ac-mod-head .label {
  font-family: var(--sans); font-size: .72rem;
  letter-spacing: .26em; text-transform: uppercase;
  color: var(--gold);
  margin-bottom: 18px;
  display: block;
}
.ac-mod-head .h1 { margin-bottom: 24px; }
.ac-mod-head .lede { max-width: 540px; }

.ac-pain { background: var(--bg); }
.ac-pain-list { border-top: 1px solid var(--bone-h); }
.ac-pain-row {
  display: grid; grid-template-columns: 60px 1fr; gap: 24px;
  padding: 22px 0;
  border-bottom: 1px solid var(--bone-h);
  align-items: baseline;
}
.ac-pain-row .num {
  font-family: var(--serif); font-style: italic;
  font-size: 1.3rem; color: var(--gold);
  letter-spacing: .03em;
}
.ac-pain-row p {
  font-family: var(--serif); font-size: 1.1rem;
  line-height: 1.5; color: var(--bone);
  letter-spacing: -.005em;
}
.ac-pain-row p strong { font-weight: 500; color: var(--bone); }
.ac-pain-row p em { font-style: italic; color: var(--bone-d); }

.ac-prod { background: var(--bg); }
.ac-prod-list { border-top: 1px solid var(--bone-h); }
.ac-prod-row {
  display: grid; grid-template-columns: 60px 1fr auto; gap: 24px;
  padding: 26px 0;
  border-bottom: 1px solid var(--bone-h);
  align-items: baseline;
  transition: padding .4s ease;
}
.ac-prod-row:hover { padding-left: 8px; padding-right: 8px; }
.ac-prod-row .roman {
  font-family: var(--serif); font-style: italic;
  font-size: 1.6rem; color: var(--gold);
  letter-spacing: .04em;
}
.ac-prod-row .info .name {
  font-family: var(--serif); font-weight: 400;
  font-size: 1.4rem; letter-spacing: -.01em;
  color: var(--bone);
  margin-bottom: 4px;
}
.ac-prod-row .info .sub {
  font-family: var(--serif); font-style: italic; font-weight: 400;
  font-size: .92rem; color: var(--bone-f);
}
.ac-prod-row .pg {
  font-family: var(--sans); font-size: .8rem;
  letter-spacing: .26em; color: var(--bone-d);
  align-self: center;
}
.ac-prod .tail {
  font-family: var(--serif); font-style: italic;
  text-align: center; color: var(--bone);
  font-size: 1.15rem; line-height: 1.5;
  margin-top: clamp(40px, 6vw, 60px);
}

.ac-quote { text-align: center; padding: clamp(40px, 6vw, 64px) 0; }
.ac-quote .star { color: var(--gold); font-size: 1rem; }
.ac-quote .q {
  font-family: var(--serif); font-style: italic; font-weight: 400;
  font-size: clamp(1.35rem, 3vw, 1.8rem);
  line-height: 1.4; letter-spacing: -.012em;
  color: var(--bone);
  max-width: 620px; margin: 24px auto;
}

.ac-bonus { background: var(--bg); }
.ac-bonus .head { margin-bottom: 50px; }
.ac-bonus .head .h2 { margin-bottom: 14px; }
.ac-bonus .head .sub {
  font-family: var(--serif); font-style: italic;
  color: var(--bone-d); font-size: 1rem;
}
.ac-b-grid { border-top: 1px solid var(--bone-h); }
.ac-b-row {
  display: grid; grid-template-columns: 50px 1fr auto; gap: 24px;
  padding: 22px 0;
  border-bottom: 1px solid var(--bone-h);
  align-items: baseline;
}
.ac-b-row .roman {
  font-family: var(--serif); font-style: italic;
  font-size: 1.1rem; color: var(--gold);
}
.ac-b-row .name {
  font-family: var(--serif); font-weight: 500;
  font-size: 1.1rem; color: var(--bone);
  margin-bottom: 4px;
  letter-spacing: -.005em;
}
.ac-b-row .desc {
  font-family: var(--serif); font-style: italic;
  color: var(--bone-d); font-size: .92rem; line-height: 1.45;
}
.ac-b-row .price {
  display: flex; flex-direction: column; align-items: flex-end; gap: 4px;
}
.ac-b-row .price .old {
  font-family: var(--serif); font-style: italic;
  text-decoration: line-through; color: var(--bone-f); font-size: .9rem;
}
.ac-b-row .price .inc {
  font-family: var(--sans); font-size: .68rem;
  letter-spacing: .26em; text-transform: uppercase;
  color: var(--gold); font-weight: 500;
}
@media(max-width: 640px) {
  .ac-b-row { grid-template-columns: 36px 1fr; }
  .ac-b-row .price { grid-column: 2; align-items: flex-start; flex-direction: row; gap: 12px; }
}

.ac-important {
  margin: clamp(40px, 6vw, 56px) 0;
  padding: 22px 24px;
  border: 1px solid rgba(201,122,82,.4);
  border-radius: 4px;
  background: rgba(201,122,82,.04);
}
.ac-important .label {
  font-family: var(--sans); font-size: .68rem;
  letter-spacing: .28em; text-transform: uppercase;
  color: var(--terra);
  margin-bottom: 10px;
  display: block;
}
.ac-important p {
  font-family: var(--serif); font-size: .98rem;
  line-height: 1.55; color: var(--bone);
}

.ac-price { background: var(--bg); }
.ac-cdwrap {
  display: flex; justify-content: center; align-items: center; gap: 14px;
  margin-bottom: 44px;
  font-family: var(--sans); font-size: .7rem;
  letter-spacing: .26em; text-transform: uppercase;
  color: var(--bone-d);
}
.ac-cd {
  font-family: var(--serif); font-feature-settings: 'tnum' 1;
  font-size: 1.1rem; font-weight: 500; letter-spacing: .04em;
  color: var(--gold);
  padding: 5px 14px;
  border: 1px solid var(--bone-h);
  border-radius: 4px;
  text-transform: none;
}

.ac-price-box {
  position: relative;
  background: var(--bg-2);
  border: 1px solid var(--bone-h);
  border-radius: 6px;
  padding: clamp(36px, 5vw, 60px);
}
.ac-price-box::before, .ac-price-box::after {
  content: ''; position: absolute; pointer-events: none;
  width: 14px; height: 14px;
  border: 1px solid var(--gold);
}
.ac-price-box::before { top: -1px; left: -1px; border-right: 0; border-bottom: 0; }
.ac-price-box::after  { bottom: -1px; right: -1px; border-left: 0; border-top: 0; }
.ac-price-box .ph {
  font-family: var(--sans); font-size: .68rem;
  letter-spacing: .28em; text-transform: uppercase;
  color: var(--gold);
  margin-bottom: 10px; display: block; text-align: center;
}
.ac-price-box .h2 { text-align: center; margin-bottom: 36px; }
.ac-pl { list-style: none; padding: 0; margin: 0 0 32px; }
.ac-pl li {
  display: flex; justify-content: space-between; align-items: baseline;
  gap: 16px; padding: 13px 0;
  border-bottom: 1px solid var(--bone-h);
  font-family: var(--serif); font-size: 1rem;
}
.ac-pl li:last-child { border: 0; }
.ac-pl .nm { color: var(--bone); display: flex; align-items: baseline; gap: 12px; }
.ac-pl .nm .ix {
  font-family: var(--serif); font-style: italic;
  color: var(--gold); font-size: .85rem; min-width: 18px;
}
.ac-pl .vl { color: var(--bone-f); font-feature-settings: 'tnum' 1; font-style: italic; }

.ac-totals { text-align: center; padding: 28px 0 8px; border-top: 1px solid var(--bone-h); }
.ac-totals .old {
  font-family: var(--serif); font-style: italic;
  font-size: .9rem; color: var(--bone-f); margin-bottom: 10px;
}
.ac-totals .old s { color: var(--terra); }
.ac-totals .now {
  font-family: var(--serif); font-weight: 400;
  font-size: clamp(3rem, 8vw, 4.6rem);
  line-height: 1; letter-spacing: -.04em;
  color: var(--bone);
  font-feature-settings: 'tnum' 1;
}
.ac-totals .now small {
  font-family: var(--sans); font-size: .22em; font-weight: 500;
  color: var(--bone-f); margin-left: 8px; letter-spacing: .12em;
}
.ac-totals .save {
  display: inline-block; margin-top: 16px;
  font-family: var(--sans); font-size: .7rem; font-weight: 500;
  letter-spacing: .22em; text-transform: uppercase;
  color: var(--gold);
}

.ac-ctaw { text-align: center; margin-top: 36px; }
.ac-ctaw .btn { width: 100%; max-width: 380px; }
.ac-ctaw .slots {
  margin-top: 16px;
  font-family: var(--serif); font-style: italic;
  font-size: .9rem; color: var(--bone-d);
}
.ac-ctaw .slots strong { color: var(--gold); font-weight: 500; font-style: normal; }
.ac-ctaw .micro {
  margin-top: 6px;
  font-family: var(--sans); font-size: .68rem;
  letter-spacing: .22em; text-transform: uppercase;
  color: var(--bone-f);
}

.ac-testi { background: var(--bg); }
.ac-testi-grid {
  display: grid; gap: 1px;
  background: var(--bone-h);
  border-top: 1px solid var(--bone-h);
  border-bottom: 1px solid var(--bone-h);
}
@media(min-width: 760px) { .ac-testi-grid { grid-template-columns: 1fr 1fr; } }
.ac-t {
  background: var(--bg);
  padding: 34px 30px;
  display: flex; flex-direction: column;
}
.ac-t .star { color: var(--gold); font-size: .9rem; margin-bottom: 18px; }
.ac-t .quote {
  font-family: var(--serif); font-style: italic; font-weight: 400;
  font-size: 1.1rem; line-height: 1.55; letter-spacing: -.008em;
  color: var(--bone); margin-bottom: 26px;
}
.ac-t .who {
  font-family: var(--sans); font-size: .72rem;
  letter-spacing: .22em; text-transform: uppercase;
  color: var(--bone-d);
  margin-top: auto;
}
.ac-t .who .nm { color: var(--bone); font-weight: 500; }

.ac-how { background: var(--bg); }
.ac-how-list { border-top: 1px solid var(--bone-h); }
.ac-how-row {
  display: grid; grid-template-columns: 60px 1fr; gap: 24px;
  padding: 28px 0;
  border-bottom: 1px solid var(--bone-h);
  align-items: baseline;
}
.ac-how-row .num {
  font-family: var(--serif); font-style: italic;
  font-size: 1.3rem; color: var(--gold);
}
.ac-how-row .nm {
  font-family: var(--serif); font-weight: 500;
  font-size: 1.25rem; color: var(--bone); margin-bottom: 6px;
  letter-spacing: -.01em;
}
.ac-how-row .desc {
  font-family: var(--serif); color: var(--bone-d);
  font-size: 1rem; line-height: 1.5;
}

.ac-faq { background: var(--bg); }
.ac-faq-list { border-top: 1px solid var(--bone-h); }
.ac-faq-item { border-bottom: 1px solid var(--bone-h); }
.ac-faq-q {
  width: 100%;
  display: flex; justify-content: space-between; align-items: center;
  gap: 24px; padding: 24px 4px;
  font-family: var(--serif); font-weight: 400;
  color: var(--bone); font-size: 1.2rem; letter-spacing: -.012em;
  text-align: left;
  transition: color .25s ease;
}
.ac-faq-q:hover { color: var(--gold); }
.ac-faq-q .pl {
  flex-shrink: 0; width: 22px; height: 22px;
  position: relative; opacity: .65;
  transition: transform .35s cubic-bezier(.2,.7,.2,1), opacity .25s;
  color: var(--gold);
}
.ac-faq-q .pl::before, .ac-faq-q .pl::after {
  content: ''; position: absolute; top: 50%; left: 50%;
  background: currentColor;
}
.ac-faq-q .pl::before { width: 14px; height: 1px; transform: translate(-50%,-50%); }
.ac-faq-q .pl::after  { width: 1px; height: 14px; transform: translate(-50%,-50%); transition: opacity .25s; }
.ac-faq-item.open .pl { opacity: 1; }
.ac-faq-item.open .pl::after { opacity: 0; }
.ac-faq-a { max-height: 0; overflow: hidden; transition: max-height .45s cubic-bezier(.2,.7,.2,1); }
.ac-faq-a-in {
  padding: 0 4px 26px;
  font-family: var(--serif); color: var(--bone-d);
  font-size: 1rem; line-height: 1.65; max-width: 620px;
}
.ac-faq-item.open .ac-faq-a { max-height: 420px; }

.ac-final {
  background:
    radial-gradient(ellipse 60% 50% at 50% 50%, rgba(201,169,97,.1), transparent 65%),
    var(--bg);
  text-align: center;
}
.ac-final .h1 { max-width: 700px; margin: 18px auto 26px; }
.ac-final .lede { max-width: 540px; margin: 0 auto 44px; }
.ac-final .guarantee {
  display: inline-flex; align-items: center; gap: 10px;
  margin-top: 32px; padding: 9px 18px;
  font-family: var(--sans); font-size: .7rem;
  letter-spacing: .22em; text-transform: uppercase;
  color: var(--bone-d);
  border: 1px solid var(--bone-h);
  border-radius: 999px;
}
.ac-final .guarantee::before {
  content: ''; width: 5px; height: 5px; border-radius: 50%;
  background: var(--gold);
}

.ac-foot {
  background: var(--bg);
  padding: 48px 24px 36px;
  border-top: 1px solid var(--bone-h);
}
.ac-foot-inner {
  max-width: 1180px; margin: 0 auto;
  display: flex; flex-direction: column; align-items: center; gap: 24px;
  text-align: center;
}
.ac-foot-mark {
  font-family: var(--serif); font-style: italic;
  color: var(--gold); font-size: 1.5rem;
  letter-spacing: .02em;
}
.ac-foot-links {
  display: flex; flex-wrap: wrap; gap: 8px 28px;
  font-family: var(--sans); font-size: .7rem;
  letter-spacing: .22em; text-transform: uppercase;
}
.ac-foot-links a { color: var(--bone-d); transition: color .25s; }
.ac-foot-links a:hover { color: var(--gold); }
.ac-foot-copy {
  font-family: var(--serif); font-style: italic;
  color: var(--bone-f); font-size: .85rem;
}

.ac-sticky {
  position: fixed; bottom: 0; left: 0; right: 0;
  padding: 14px 16px calc(14px + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, transparent, rgba(7,17,10,.95) 40%, var(--ink));
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  z-index: 90;
  transform: translateY(110%);
  transition: transform .5s cubic-bezier(.2,.7,.2,1);
  display: none;
}
.ac-sticky.show { transform: translateY(0); }
.ac-sticky .btn { width: 100%; padding: 16px 24px; }
@media(max-width: 768px) { .ac-sticky { display: block; } }

.ac-toast {
  position: fixed; bottom: 100px; left: 16px;
  max-width: 280px;
  padding: 14px 16px;
  background: rgba(7,17,10,.9);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
