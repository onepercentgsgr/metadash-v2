# ════════════════════════════════════════════════════════════════
# CRITICAL SECURITY - Must be set in production
# ════════════════════════════════════════════════════════════════

# Database connection
DATABASE_URL=postgresql://user:password@localhost:5432/metadash

# JWT secret key (min 32 chars)
SECRET_KEY=your-super-secret-key-change-this-in-production

# Credential encryption key (generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=your-encryption-key-here

# Admin credentials
ADMIN_EMAIL=admin@metadash.com
ADMIN_PASSWORD=your-admin-password-change-this

# ════════════════════════════════════════════════════════════════
# CORS Configuration
# ════════════════════════════════════════════════════════════════

# Allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,https://metadash.vercel.app

# Frontend URL
FRONTEND_URL=https://metadash.vercel.app

# ════════════════════════════════════════════════════════════════
# Third-party APIs
# ════════════════════════════════════════════════════════════════

ANTHROPIC_API_KEY=your-anthropic-api-key
META_ACCESS_TOKEN=your-meta-access-token
META_AD_ACCOUNT_ID=your-meta-ad-account-id

# ════════════════════════════════════════════════════════════════
# Payment Integrations
# ════════════════════════════════════════════════════════════════

STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_STARTER_PRICE_ID=price_starter
STRIPE_PRO_PRICE_ID=price_pro
STRIPE_ENTERPRISE_PRICE_ID=price_enterprise

MERCADOPAGO_ACCESS_TOKEN=your-mercadopago-access-token
MERCADOPAGO_WEBHOOK_TOKEN=your-webhook-token

# ════════════════════════════════════════════════════════════════
# Email Configuration (for email verification)
# ════════════════════════════════════════════════════════════════

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@metadash.com

# ════════════════════════════════════════════════════════════════
# Environment & Logging
# ════════════════════════════════════════════════════════════════

ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=info
